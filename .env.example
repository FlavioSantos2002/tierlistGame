# Configuração do Tier List. Copie para .env e preencha:  cp .env.example .env
# Formato NOME=valor, SEM espaços ao redor do "=" (o iniciar.sh carrega com ". ./.env").
# Final de linha LF: não edite este arquivo no Bloco de Notas do Windows.

# Senha do painel do admin. OBRIGATÓRIA; o app não sobe vazia nem com este valor.
# Use algo longo e aleatório. Para gerar:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=troque-este-token

# Chave que assina o cookie da sessão. OBRIGATÓRIA; mesma regra e mesmo comando acima.
SECRET_KEY=troque-esta-chave

# Caminho do banco SQLite e do arquivo de temas (relativos à pasta do projeto).
DB_PATH=./tierlist.db
TEMAS_PATH=./temas.json

# Métricas do cloudflared deste projeto (o convite usa a 2000; não use a mesma).
TUNEL_METRICS=127.0.0.1:2001

# Endereço público fixo (opcional). Vazio = descobre o do quick tunnel sozinho.
BASE_URL=
